# ── Portfolio template environment ─────────────────────────────────────────
# Copy this file to `.env.local` and fill in what you need.
#   cp .env.example .env.local
#
# This template only requires ONE optional variable.

# Optional: a GitHub Personal Access Token used by the "Peer Signal" section to
# fetch your live contribution graph + repo stats.
#
# Without it, requests use the public GitHub API (60/hour) — fine for local dev.
# With it, the limit rises to 5,000/hour. A classic PAT with NO scopes selected
# is enough for public profile data.
#   Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=
